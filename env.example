# ─── Evolution API ───────────────────────────────────────────────────────────
# URL de tu instancia en Railway (sin barra al final)
EVOLUTION_URL=https://tu-evolution-api.railway.app

# Nombre de la instancia que creaste en Evolution API
EVOLUTION_INSTANCE=sanguicheria

# API Key que configuraste al desplegar Evolution API
EVOLUTION_API_KEY=tu-api-key-aqui

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
# Número(s) a notificar. Con código de país, sin +, sin espacios.
# Para agregar más, separa con coma: 56912345678,56987654321
WHATSAPP_NUMEROS=56912345678

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
